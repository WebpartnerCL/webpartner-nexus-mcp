# ============================================================================
# WebPartner Nexus MCP — variables de entorno.
# Copia este archivo a .env y completa los SECRETOS. NUNCA commitees el .env real.
# Para correr con estas variables: node --env-file=.env dist/index.js
# ============================================================================

PORT=3000

# ── Supabase (capa de datos) ──
SUPABASE_URL=https://banhnvizuzpmlhnchsfn.supabase.co
# SECRETO — service_role key (Dashboard → Settings → API). Omite RLS; solo en env.
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude (cerebro IA) ──
# SECRETO — API key de Anthropic.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── n8n (orquestación) ──
N8N_WEBHOOK_BASE=https://n8n.srv1105450.hstgr.cloud/webhook

# ── WhatsApp Cloud API (Meta) ── (opcional hasta activar M1/M3 salientes)
# SECRETO — token del System User de Meta.
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ── Base pública para links de reseña (M2) ──
PUBLIC_BASE_URL=https://webpartners.cl
